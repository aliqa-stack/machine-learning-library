CXX = g++
CXXFLAGS = -Iheaders -std=c++17 -Wall -Wextra

.PHONY: all run clean

all: main

main: main.cpp src/algorithmTrain.cpp src/MeanSquared.cpp headers/algoritma.h headers/Mean.h
	$(CXX) $(CXXFLAGS) main.cpp src/algorithmTrain.cpp src/MeanSquared.cpp -o main

run: main
	./main

clean:
	rm -f main
